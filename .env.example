# ==============================================================================
# Environment Variables — Static React Site (Dr. Krupali Donda)
# No database. No auth. No backend. Only public CDN/analytics variables needed.
# ==============================================================================

# ──── Site Domain ────
VITE_SITE_URL="https://krupalidonda.com"

# ──── Cloudinary CDN (image delivery only — no upload key needed) ────
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ──── Contact Form (Formspree — sign up free at https://formspree.io) ────
# After creating a form, replace YOUR_FORM_ID in ContactFormSection.tsx
# FORMSPREE_FORM_ID="your-form-id"

# ──── Observability & Analytics (Optional) ────
VITE_GA_ID=""
VITE_GTM_ID=""
VITE_SENTRY_DSN=""

# ──── Build Time Flags (Dev Only) ────
ANALYZE="false"
